{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(vercel env pull:*)",
      "Bash(npx vercel env pull:*)",
      "Bash(prisma migrate reset:*)",
      "Bash(npx prisma migrate reset:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-production-writes.sh",
            "statusMessage": "Checking for production writes"
          }
        ]
      }
    ]
  }
}
