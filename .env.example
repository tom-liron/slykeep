# Copy this file to `.env` for local development. Configure deployment values in the hosting
# environment.

# Database (Neon Postgres)
# Use development-branch credentials locally. Prisma Client uses the pooled URL; Prisma CLI uses
# the direct URL for migrations and seeding.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=verify-full&channel_binding=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DATABASE?sslmode=verify-full&channel_binding=require"

# Authentication (Auth.js)
# Generate with `npx auth secret` or `openssl rand -base64 32`.
AUTH_SECRET=""

# Application URL used for Auth.js, email links, and Stripe return URLs.
AUTH_URL="http://localhost:3000"
# Legacy fallback, used only when AUTH_URL is unset:
# NEXTAUTH_URL="http://localhost:3000"

# GitHub OAuth — https://github.com/settings/developers
# Local callback: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Email (Resend) — https://resend.com/api-keys
# EMAIL_FROM must be an address on a domain verified at https://resend.com/domains; Resend
# refuses every other recipient with a 403. `npm run email:test -- you@example.com` proves it.
RESEND_API_KEY=""
EMAIL_FROM="SlyKeep <noreply@slykeep.com>"

# Rate limiting (Upstash Redis) — https://console.upstash.com
# Optional locally; configure both values in production to enable rate limits.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# File storage (Cloudflare R2)
# Required for file and image items. Keep the bucket private; reads are authorized through
# `/api/files/[id]`.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
# Optional public R2 URL. DevStash reads files through `/api/files/[id]` and does not use this
# value.
R2_PUBLIC_URL=""

# Billing (Stripe)
# Required for Checkout, Billing Portal, and subscription synchronization. Configure matching
# key, webhook secret, and price IDs for each environment.
STRIPE_SECRET_KEY=""
# Optional browser key retained for client-side Stripe integrations. Hosted Checkout does not use it.
STRIPE_PUBLISHABLE_KEY=""
# Local webhook forwarding: stripe listen --forward-to localhost:3000/api/webhook/stripe
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID_MONTHLY=""
STRIPE_PRICE_ID_YEARLY=""

# AI (OpenAI)
# Required for Pro AI actions.
OPENAI_API_KEY=""

# Scheduled jobs
# Vercel uses this to authenticate the unverified-account cleanup cron.
# In a terminal, run `openssl rand -base64 32`, then paste its output between these quotes.
CRON_SECRET=""

# Local-only override for the production database guard. Leave unset normally.
ALLOW_PRODUCTION_DB=""
