{
    "name": "devstash",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "monaco:sync": "tsx scripts/sync-monaco.ts",
        "predev": "npm run monaco:sync",
        "dev": "next dev",
        "prebuild": "npm run monaco:sync",
        "build": "next build",
        "start": "next start",
        "lint": "eslint",
        "format": "prettier --write .",
        "test": "vitest run",
        "billing:test": "vitest run --config vitest.integration.config.ts",
        "postinstall": "prisma generate",
        "db:migrate": "prisma migrate dev",
        "db:seed": "prisma db seed",
        "db:seed:types": "tsx prisma/seed.ts --types-only",
        "db:reset": "tsx scripts/clear-users.ts && prisma db seed",
        "db:test": "tsx scripts/test-db.ts",
        "email:test": "tsx scripts/test-email.ts",
        "user:verify": "tsx scripts/verify-user.ts",
        "users:sweep": "tsx --conditions=react-server scripts/sweep-unverified.ts",
        "db:status": "prisma migrate status",
        "db:studio": "prisma studio",
        "db:deploy": "prisma migrate deploy"
    },
    "dependencies": {
        "@auth/prisma-adapter": "^2.11.3",
        "@aws-sdk/client-s3": "^3.1104.0",
        "@monaco-editor/react": "^4.7.0",
        "@prisma/adapter-pg": "^7.8.0",
        "@prisma/client": "^7.8.0",
        "@upstash/ratelimit": "^2.0.8",
        "@upstash/redis": "^1.38.1",
        "bcryptjs": "^3.0.3",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "dotenv": "^17.4.2",
        "lucide-react": "^1.24.0",
        "next": "16.2.9",
        "next-auth": "^5.0.0-beta.32",
        "openai": "^7.5.0",
        "pg": "^8.22.0",
        "radix-ui": "^1.6.2",
        "react": "19.2.4",
        "react-dom": "19.2.4",
        "react-markdown": "^10.1.0",
        "remark-gfm": "^4.0.1",
        "resend": "^6.18.1",
        "server-only": "^0.0.1",
        "shadcn": "^4.13.0",
        "sonner": "^2.0.7",
        "stripe": "^22.5.0",
        "tailwind-merge": "^3.6.0",
        "tw-animate-css": "^1.4.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4",
        "@types/bcryptjs": "^2.4.6",
        "@types/node": "^20",
        "@types/pg": "^8.20.0",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "babel-plugin-react-compiler": "1.0.0",
        "eslint": "^9",
        "eslint-config-next": "16.2.9",
        "monaco-editor": "0.56.0",
        "prettier": "^3.4.2",
        "prisma": "^7.8.0",
        "tailwindcss": "^4",
        "tsx": "^4.23.1",
        "typescript": "^5",
        "vitest": "^4.1.10"
    }
}
